# Copy to .env (git-ignored) and fill in the providers you use.
# skrubify searches for .env / .env.local / .skrubify.env from the current
# directory up to the repository root, then inside the package.
# Existing environment variables always win; --env-file FILE forces one file.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
